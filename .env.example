# ==================================================
# KANOONI KARHVAHI - ENVIRONMENT CONFIGURATION
# ==================================================

# Application
APP_ENV=development
APP_NAME="Kanooni Karhvahi"
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (PostgreSQL with pgvector)
# For local development with Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/kanooni_karhvahi
# Inside Docker network: postgresql+asyncpg://postgres:postgres@postgres:5432/kanooni_karhvahi
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kanooni_karhvahi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/kanooni_karhvahi

# Redis & Celery
# For local development: redis://localhost:6379/0
# Inside Docker network: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI & LLM Provider Configuration
# Supported: gemini, openai, mock
# Set to 'mock' for development without API credentials
LLM_PROVIDER=mock
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
# Low temperature = conservative, factual legal analysis
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=4096
# Bump when prompts change materially (invalidates cached analysis)
AI_PROMPT_VERSION=phase5-v1

# Embeddings Configuration
# Supported: gemini, openai, huggingface, mock
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-004
# Dimension must match the selected model:
#   gemini text-embedding-004        = 768
#   openai text-embedding-3-small    = 1536
#   huggingface all-MiniLM-L6-v2     = 384
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Semantic Chunking Configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# OCR Provider Configuration
# Supported: tesseract, easyocr, google_vision, mock
OCR_PROVIDER=mock

# Storage Provider Configuration
# Supported: local, s3, mock
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Document Privacy & TTL
DOCUMENT_TTL_HOURS=24
MAX_FILE_SIZE_MB=25

# Security
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
