# ==================================================
# KANOONI KARHVAHI - ENVIRONMENT CONFIGURATION
# ==================================================
# Copy this file to .env and fill in the values.
# Never commit your real .env file to version control.

# Application
APP_ENV=development
APP_NAME="Kanooni Karhvahi"
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --------------------------------------------------
# Database (PostgreSQL with pgvector)
# --------------------------------------------------
# "postgres" is the Docker Compose service name defined in docker-compose.yml.
# Use this hostname when the API/worker containers run inside the Docker network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kanooni_karhvahi
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/kanooni_karhvahi
# If running the API directly on your host (outside Docker), use localhost instead:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kanooni_karhvahi
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/kanooni_karhvahi

# --------------------------------------------------
# Redis & Celery
# --------------------------------------------------
# "redis" is the Docker Compose service name defined in docker-compose.yml.
# Use these URLs when running inside the Docker network.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# If running outside Docker, use localhost instead:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --------------------------------------------------
# LLM Provider — GroqCloud
# --------------------------------------------------
# Groq provides fast OpenAI-compatible LLM inference.
# Get your API key at: https://console.groq.com/keys
#
# Supported values for LLM_PROVIDER: groq | gemini | mock
#   - groq  : GroqCloud (recommended for production/staging)
#   - mock  : No API key required; returns deterministic stub responses
#             Safe for local development and CI without credentials.
#
# WARNING: Never hardcode your API key in source code or commit it to git.
LLM_PROVIDER=groq
# Paste your GroqCloud API key below (starts with "gsk_..."):
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
# Groq's OpenAI-compatible endpoint — consumed by the Groq provider class.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Generation parameters
# Low temperature = conservative, factual legal analysis
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=4096
# Bump when prompts change materially (invalidates cached analysis)
AI_PROMPT_VERSION=phase5-v1

# --------------------------------------------------
# Embeddings Configuration
# --------------------------------------------------
# NOTE: Groq is used for LLM inference (above). Embeddings are a separate
# pipeline and are NOT provided by Groq. The mock provider is the only
# currently implemented embedding backend; real providers (OpenAI, HuggingFace)
# are planned for a future phase.
#
# Supported values for EMBEDDING_PROVIDER: mock
#   mock : Deterministic hash-based vectors — no API key required.
#          Suitable for development and testing.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Vector dimension must match the selected model.
# Mock provider uses EMBEDDING_DIMENSION directly (default 768).
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Semantic Chunking Configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --------------------------------------------------
# OCR Provider Configuration
# --------------------------------------------------
# Supported: tesseract | easyocr | google_vision | mock
OCR_PROVIDER=mock

# --------------------------------------------------
# Storage Provider Configuration
# --------------------------------------------------
# Supported: local | s3 | mock
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# --------------------------------------------------
# Document Privacy & TTL
# --------------------------------------------------
DOCUMENT_TTL_HOURS=24
MAX_FILE_SIZE_MB=25

# --------------------------------------------------
# Security
# --------------------------------------------------
# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
